# ScrapeSignal environment template
# Copy to .env and fill in production values before running live jobs.

# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=text
DRY_RUN=True

# Database (Neon pooled connection string recommended)
# Get from: npx neonctl connection-string --project-id <id> --pooled
# Local docker-compose postgres (host port 5433): use sslmode=disable
# DATABASE_URL=postgresql+psycopg://scrapesignal:scrapesignal@127.0.0.1:5433/scrapesignal?sslmode=disable
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE_SECONDS=3600

# Delivery
POWER_AUTOMATE_WEBHOOK_URL="https://your-flow-url-with-full-query-string-including-sig"
POWER_AUTOMATE_PAYLOAD_FORMAT=html
EMAIL_SUBJECT_PREFIX=ScrapeSignal Daily Brief
ARTICLES_PER_EMAIL=20

# Schedule
DELIVERY_TIME_IST=07:00
DELIVERY_TIME_UTC=01:30
CRON_SCHEDULE=30 1 * * *
TIMEZONE=Asia/Kolkata

# Scoring and retention
MIN_RELEVANCE_SCORE=70.0
DEDUPLICATION_WINDOW_DAYS=30
KEEP_ARTICLES_DAYS=90
MAX_EXECUTION_MINUTES=10

# Scraping
SCRAPE_TIMEOUT_SECONDS=30
SCRAPE_CONNECT_TIMEOUT_SECONDS=5
SCRAPE_CONCURRENCY=14
PDF_TIMEOUT_SECONDS=30
MAX_ARTICLES_PER_SOURCE=150
NATIVE_MAX_ARTICLE_PAGES=15
USER_AGENT=ScrapeSignal/0.1 (+https://github.com/scrapesignal)

# Scraping APIs (chain order: native -> Jina -> Apify)
JINA_API_KEY=
APIFY_API_TOKEN=
APIFY_ACTOR_ID=apify~website-content-crawler
APIFY_RUN_TIMEOUT_SECONDS=300
FIRECRAWL_API_KEY=

# LLM summarization (primary: Groq, fallback: Gemini free models)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL_FALLBACKS=gemini-2.5-flash,gemini-3-flash-preview,gemini-2.0-flash
LLM_MAX_TOKENS=2048
LLM_REQUESTS_PER_MINUTE=20

# Alerts
SLACK_WEBHOOK_URL=
SLACK_ALERT_SEVERITY_THRESHOLD=error

# Observability
LOG_FILE_PATH=scrapesignal.log
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5
